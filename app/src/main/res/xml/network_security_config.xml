<?xml version="1.0" encoding="utf-8"?>
<!--
  A proxy client must reach plain-HTTP health endpoints: the keep-alive URL is user
  configurable and the confidentiality comes from the tunnel, not the probe.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
