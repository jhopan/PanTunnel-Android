<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/splitToolbar"
        style="@style/PanTunnelToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Split tunnel"
        app:titleTextColor="@color/text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <CheckBox
            android:id="@+id/splitEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent"
            android:text="@string/split_enable"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/splitMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/splitAllow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent"
                android:text="@string/split_mode_allow"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/splitBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent"
                android:text="@string/split_mode_block"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </RadioGroup>

        <EditText
            android:id="@+id/splitSearch"
            style="@style/PanTunnelField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Cari aplikasi…"
            android:inputType="text" />
    </LinearLayout>

    <TextView
        android:id="@+id/splitSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/accent_cyan"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/splitList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/splitSave"
        style="@style/PanTunnelPrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="14dp"
        android:text="@string/save" />
</LinearLayout>
